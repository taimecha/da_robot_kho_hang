Panels:
- Class: rviz_common/Displays
  Name: Displays
  Help Height: 0
  Tree Height: 400
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Map
    Name: Ban do
    Enabled: true
    Alpha: 0.7
    Color Scheme: map
    Draw Behind: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map
    Update Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map_updates
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Name: Sa ban + hai xe
    Enabled: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /fleet/markers
    Namespaces: {}
    Value: true
  - Class: rviz_common/Group
    Enabled: true
    Name: Xe 1 (agv1)
    Displays:
    - Class: rviz_default_plugins/RobotModel
      Name: Mo hinh xe
      Enabled: true
      Alpha: 1
      Description Source: Topic
      Description File: ''
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /agv1/robot_description
      TF Prefix: agv1
      Visual Enabled: true
      Collision Enabled: false
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /fleet_viz/agv1/scan
      Style: Points
      Size (Pixels): 5
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Alpha: 1
      Decay Time: 0
      Position Transformer: XYZ
      Use Fixed Frame: true
      Selectable: true
      Value: true
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: Hat AMCL
      Enabled: true
      Color: 38; 115; 242
      Alpha: 1
      Shape: Arrow (Flat)
      Min Arrow Length: 0.02
      Max Arrow Length: 0.3
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /agv1/particle_cloud
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: true
      Alpha: 0.7
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /agv1/local_costmap/costmap
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /agv1/local_costmap/costmap_updates
      Use Timestamp: false
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: false
      Alpha: 0.3
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /agv1/global_costmap/costmap
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /agv1/global_costmap/costmap_updates
      Use Timestamp: false
      Value: false
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Color: 38; 115; 242
      Alpha: 1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /agv1/local_costmap/published_footprint
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Doan dang chay
      Enabled: true
      Color: 38; 115; 242
      Alpha: 1
      Buffer Length: 1
      Line Style: Lines
      Line Width: 0.03
      Pose Style: None
      Offset:
        X: 0
        Y: 0
        Z: 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /agv1/received_global_plan
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Enabled: true
      Color: 0; 12; 255
      Alpha: 1
      Buffer Length: 1
      Line Style: Lines
      Line Width: 0.03
      Pose Style: None
      Offset:
        X: 0
        Y: 0
        Z: 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /agv1/local_plan
      Value: true
  - Class: rviz_common/Group
    Enabled: true
    Name: Xe 2 (agv2)
    Displays:
    - Class: rviz_default_plugins/RobotModel
      Name: Mo hinh xe
      Enabled: true
      Alpha: 1
      Description Source: Topic
      Description File: ''
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /agv2/robot_description
      TF Prefix: agv2
      Visual Enabled: true
      Collision Enabled: false
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /fleet_viz/agv2/scan
      Style: Points
      Size (Pixels): 5
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Alpha: 1
      Decay Time: 0
      Position Transformer: XYZ
      Use Fixed Frame: true
      Selectable: true
      Value: true
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: Hat AMCL
      Enabled: true
      Color: 242; 128; 26
      Alpha: 1
      Shape: Arrow (Flat)
      Min Arrow Length: 0.02
      Max Arrow Length: 0.3
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /agv2/particle_cloud
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: true
      Alpha: 0.7
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /agv2/local_costmap/costmap
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /agv2/local_costmap/costmap_updates
      Use Timestamp: false
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: false
      Alpha: 0.3
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /agv2/global_costmap/costmap
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /agv2/global_costmap/costmap_updates
      Use Timestamp: false
      Value: false
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Color: 242; 128; 26
      Alpha: 1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /agv2/local_costmap/published_footprint
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Doan dang chay
      Enabled: true
      Color: 242; 128; 26
      Alpha: 1
      Buffer Length: 1
      Line Style: Lines
      Line Width: 0.03
      Pose Style: None
      Offset:
        X: 0
        Y: 0
        Z: 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /agv2/received_global_plan
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Enabled: true
      Color: 0; 12; 255
      Alpha: 1
      Buffer Length: 1
      Line Style: Lines
      Line Width: 0.03
      Pose Style: None
      Offset:
        X: 0
        Y: 0
        Z: 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /agv2/local_plan
      Value: true
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: false
    Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0
      Scale: 160
      X: -0.545
      Y: 0.035
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1300
