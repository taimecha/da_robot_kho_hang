def cmd_up(a):
    if os.path.exists(LATEST) and any(alive(p['pid']) for p in read_pids(os.path.realpath(LATEST))):
        sys.exit('He dang chay (agvctl status). Tat truoc: agvctl down')
    run = os.path.join(LOGS, time.strftime('run-%Y%m%d-%H%M%S'))
    os.makedirs(run)
    if os.path.lexists(LATEST):
        os.remove(LATEST)
    os.symlink(run, LATEST)
    cars = a.cars.split(',')
    meta = {'cars': cars, 'emulate': a.emulate, 'domain': domain(), 'tm': not a.no_tm,
            'start': time.strftime('%Y-%m-%d %H:%M:%S'),
            'agv1': os.environ.get('AGV1', '2 3 0'), 'agv2': os.environ.get('AGV2', '3 3 0')}
    json.dump(meta, open(os.path.join(run, 'meta.json'), 'w'), indent=1)
    # Phan dieu phoi chay NEN (cho xe bat nguon co the lau) - lenh nay tra ve ngay
    pid = spawn(f'python3 {os.path.realpath(__file__)} _bringup {run}', os.path.join(run, 'bringup.log'))
    add_pid(run, 'bringup', pid)
    print(f'Da bat (nen). Log: {run}\n'
          f'  Xem: agvctl status | agvctl events | agvctl logs bringup\n'
          f'  He se cho {", ".join(cars)} bat nguon (co /agvN/scan) roi moi bat Nav2.')


def _bringup(run):
    """Chay nen: agent + monitor + rosbridge -> cho xe -> fleet_real.sh -> traffic_manager."""
    meta = json.load(open(os.path.join(run, 'meta.json')))
    cars = meta['cars']

    def log(t):
        print(time.strftime('%H:%M:%S ') + t, flush=True)

    if not meta['emulate'] and not os.popen('pgrep -x micro_ros_agent').read().strip():
        add_pid(run, 'micro_ros_agent', spawn('ros2 run micro_ros_agent micro_ros_agent udp4 --port 8888',
                                              os.path.join(run, 'micro_ros_agent.log')))
        log('bat micro_ros_agent udp 8888')
    add_pid(run, 'monitor', spawn(f'python3 {WS}/tools/fleet_monitor.py {" ".join(cars)} --out {run}'
                                  + (' --emulate' if meta['emulate'] else ''),
                                  os.path.join(run, 'monitor.log')))
    log('bat fleet_monitor')
    if sh('ros2 pkg prefix rosbridge_server', timeout=30)[0] == 0:
        add_pid(run, 'rosbridge', spawn('ros2 launch rosbridge_server rosbridge_websocket_launch.xml '
                                        'port:=9090 address:=127.0.0.1',
                                        os.path.join(run, 'rosbridge.log')))
        log('bat rosbridge ws://127.0.0.1:9090 (MCP "ros")')
    else:
        log('CHUA CAI rosbridge_server -> khong co MCP ros (sudo apt install -y ros-jazzy-rosbridge-server)')

    if meta['emulate']:
        _emulate_cars(run, cars, meta, log)

    # Cho moi xe co /scan (monitor ghi status.json). Khong gioi han thoi gian.
    t0, last_say = time.time(), 0
    while True:
        st = _status(run, quiet=True)
        up = [c for c in cars if st and st['cars'].get(c, {}).get('connected')]
        if len(up) == len(cars):
            break
        if time.time() - last_say > 30:
            last_say = time.time()
            log(f'cho xe bat nguon: da co {up or "chua xe nao"}, '
                f'thieu {[c for c in cars if c not in up]} ({time.time() - t0:.0f} s)')
        time.sleep(1)
    log(f'du xe {cars} sau {time.time() - t0:.0f} s; doi 3 s cho BNO055/LiDAR on dinh')
    time.sleep(3)

    env = {'ROBOTS': ' '.join(cars), 'LOGDIR': os.path.join(run, 'fleet'), 'AGENT': '0',
           'AGV1': meta['agv1'], 'AGV2': meta['agv2']}
    if meta['emulate']:
        env['EMULATE'] = '1'
    log('tools/fleet_real.sh up ...')
    with open(os.path.join(run, 'fleet_up.log'), 'ab') as f:
        rc = subprocess.call(['bash', '-c', ROS_SETUP + f'{WS}/tools/fleet_real.sh up'],
                             stdout=f, stderr=subprocess.STDOUT, env=dict(os.environ, **env))
    log(f'fleet_real.sh xong (ma {rc}):\n' + tail(os.path.join(run, 'fleet_up.log'), 20))
    if rc != 0:
        log('Khong bat traffic_manager: chua du dieu kien dinh vi/an toan de giao nhiem vu.')
        return rc
    if meta['tm']:
        # Khong tty: traffic_manager doc lenh tu stdin + /fleet/goal. stdin la
        # 'tail -f /dev/null' de khong bao gio het (het stdin = no tu thoat).
        add_pid(run, 'traffic_manager', spawn(
            f'bash -c "tail -f /dev/null | python3 {WS}/traffic_manager.py {" ".join(cars)}"',
            os.path.join(run, 'traffic_manager.log')))
        log('bat traffic_manager (nhan lenh: agvctl goal ...)')
    log('SAN SANG')


def _emulate_cars(run, cars, meta, log):
    """ESP32 GIA (tools/fleet_fake_robot.py --esp32) de thu ca he khong can xe."""
    if domain() == 0:
        log('--emulate tren domain 0 (domain xe that) -> tu choi. Dat ROS_DOMAIN_ID=89')
        sys.exit(1)
    sys.path.insert(0, WS)
    from grid_board import Board, config_path
    import math
    b = Board.load(config_path(True))
    for c in cars:
        r, col, h = map(float, meta[c].split())
        x, y = b.xy(int(r) - 1, int(col) - 1)
        other = [o for o in cars if o != c]
        args = f'{x:.3f} {y:.3f} {h + math.degrees(b.yaw):.1f} --esp32'
        if other:
            args += f' --other /{other[0]}/truth'
        add_pid(run, f'fake_{c}', spawn(f'python3 {WS}/tools/fleet_fake_robot.py {args} '
                                        f'--ros-args -r __ns:=/{c}', os.path.join(run, f'fake_{c}.log')))
        log(f'ESP32 gia {c} tai ({meta[c]})')


def cmd_down(a):
    run = os.path.realpath(LATEST) if os.path.exists(LATEST) else None
    procs = read_pids(run) if run else []
    meta = json.load(open(os.path.join(run, 'meta.json'))) if run and \
        os.path.exists(os.path.join(run, 'meta.json')) else {'cars': ['agv1', 'agv2']}
    # Dieu phoi truoc (khong giao them lenh), roi Nav2/agent, cuoi cung monitor
    order = ['bringup', 'traffic_manager']
    for name in order:
        for p in procs:
            if p['name'] == name:
                kill_group(p['pid'], signal.SIGINT)
    env = dict(os.environ, ROBOTS=' '.join(meta['cars']))
    if run:
        env['LOGDIR'] = os.path.join(run, 'fleet')
    subprocess.call(['bash', '-c', ROS_SETUP + f'{WS}/tools/fleet_real.sh down'], env=env)
    for p in procs:
        kill_group(p['pid'], signal.SIGINT)
    time.sleep(3)
    for p in procs:
        kill_group(p['pid'], signal.SIGKILL)
    subprocess.call(['pkill', '-9', '-f', f'^python3 {WS}/(traffic_manager|tools/fleet_monitor|'
                                          f'tools/fleet_fake_robot)\\.py'])
    print('Da tat.' + (f' Log con o {run}' if run else ''))


# ---------------------------------------------------------------------- xem
def _status(run, quiet=False):
    path = os.path.join(run, 'status.json')
    try:
        return json.load(open(path))
    except (OSError, ValueError):
        if not quiet:
            print(f'(chua co {path} - monitor chua chay?)')
        return None


def cmd_status(a):
    run = run_dir()
    st = _status(run)
    procs = read_pids(run)
    if a.json:
        print(json.dumps({'run': run, 'procs': {p['name']: alive(p['pid']) for p in procs},
                          'status': st}, ensure_ascii=False, indent=1))
        return
    print(f'Lan chay: {run}')
    print('Tien trinh: ' + ', '.join(f'{p["name"]}{"" if alive(p["pid"]) else " (CHET)"}' for p in procs))
    last = tail(os.path.join(run, 'bringup.log'), 1).strip()
    print(f'Bringup: {last}')
    if not st:
        return
    age = time.time() - st['unix']
    print(f'Monitor: {st["time"]}' + (f'  !!! CU {age:.0f} s - monitor chet?' if age > 3 else '')
          + f' | domain {st["domain"]} | {st["node_count"]} node ROS')
    for n, c in st['cars'].items():
        r = c['rate_hz']
        print(f'\n[{n}] {"KET NOI" if c["connected"] else "MAT KET NOI"} | scan {r["scan"]} Hz, '
              f'joint_states {r["js"]} Hz'
              + (f' | tia hop le {c["scan_valid_ratio"]:.0%}' if c['scan_valid_ratio'] is not None else ''))
        if c['estop']:
            print(f'   !!! ESTOP: {c["estop"]}')
        if c['suspect_stuck']:
            print('   !!! co lenh chay ma banh dung yen (nghi ESTOP / ket banh / het pin)')
        d = c.get('diag')
        if d:
            print('   ESP32: ' + ', '.join(f'{k}={v}' for k, v in d.items()))
        p = c.get('pose')
        if p:
            print(f'   Vi tri: o (hang {p["row"]}, cot {p["col"]}) lech tam {p["off_node_cm"]} cm, '
                  f'huong {p["heading"]} {p["heading_off_deg"]:+.1f} do  [{p["source"]}]')
        if c.get('amcl_sd'):
            s = c['amcl_sd']
            print(f'   AMCL lech chuan: x {s["sd_x"] * 100:.1f} cm, y {s["sd_y"] * 100:.1f} cm, '
                  f'goc {s["sd_yaw_deg"]:.1f} do')
        if c.get('agent'):
            print(f'   Agent: {c["agent"]["state"]}, route {c["agent"]["route_id"]}, '
                  f'nut bi chan {c["agent"]["blocked_nodes"]}')
        if c.get('cmd_vel'):
            print(f'   cmd_vel: v {c["cmd_vel"]["v"]} m/s, w {c["cmd_vel"]["w"]} rad/s')
        if c['flags']:
            print(f'   Bat thuong: {", ".join(c["flags"])}')
    if st['missing_nodes']:
        print(f'\nThieu node: {", ".join(st["missing_nodes"])}')
    e = st['error_count']
    print(f'\nLoi tu luc bat: {e["ERROR"]} ERROR, {e["WARN"]} WARN, {e["FATAL"]} FATAL '
          f'(agvctl errors)')


def cmd_errors(a):
    print(tail(os.path.join(run_dir(), 'errors.log'), a.n), end='')


def cmd_events(a):
    print(tail(os.path.join(run_dir(), 'events.log'), a.n), end='')


def cmd_logs(a):
    run = run_dir()
    files = sorted(glob.glob(os.path.join(run, '*.log')) + glob.glob(os.path.join(run, 'fleet', '*.log')))
    names = {os.path.relpath(f, run)[:-4].replace('fleet/', ''): f for f in files}
    if not a.name:
        print('Co: ' + ', '.join(sorted(names)))
        return
    m = [k for k in names if k == a.name] or [k for k in names if a.name in k]
    if not m:
        sys.exit(f'Khong co log "{a.name}". Co: {", ".join(sorted(names))}')
    for k in m:
        print(f'===== {k} ({names[k]})')
        print(tail(names[k], a.n), end='')


# ---------------------------------------------------------------------- lenh xe
def _pub_goal(text):
    rc, out = sh(f"timeout 15 ros2 topic pub --once -w 1 /fleet/goal std_msgs/msg/String "
                 f"\"{{data: '{text}'}}\"", timeout=20)
    return rc, out


def cmd_goal(a):
    if domain() == 0 and not a.go:
        sys.exit('Domain 0 = XE THAT. Them --go khi DA DUOC PHEP cho xe chay.')
    rc, out = _pub_goal(a.text)
    if rc:
        sys.exit('Gui that bai (traffic_manager co chay khong? agvctl status):\n' + out[-500:])
    print(f'Da gui /fleet/goal: "{a.text}". Theo doi: agvctl events')


def cmd_stop(a):
    run = os.path.realpath(LATEST) if os.path.exists(LATEST) else None
    cars = json.load(open(os.path.join(run, 'meta.json')))['cars'] if run else ['agv1', 'agv2']
    _pub_goal('s')
    cmds = ' & '.join(f'timeout 5 ros2 topic pub --times 5 -r 10 /{c}/cmd_vel '
                      f'geometry_msgs/msg/Twist "{{}}" >/dev/null' for c in cars)
    sh(cmds + ' ; wait', timeout=20)
    print('Da gui lenh dung (traffic_manager "s" + cmd_vel 0).')


def cmd_localize(a):
    rc = subprocess.call(['bash', '-c', ROS_SETUP + f'cd {WS} && timeout 120 python3 '
                          f'tools/auto_initial_pose.py --ns {a.car}'])
    sys.exit(rc)


