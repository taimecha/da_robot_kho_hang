if ({reset}) {{ $p.RtsEnable = $true; Start-Sleep -Milliseconds 120; $p.RtsEnable = $false }}
# ReadExisting chu khong ReadLine: luc cho Wi-Fi/agent firmware in dau cham
# KHONG xuong dong -> ReadLine khong bao gio tra ve.
$end = (Get-Date).AddSeconds({secs}); $n = 0
while ((Get-Date) -lt $end) {{
  $s = $p.ReadExisting()
  if ($s) {{ [Console]::Out.Write($s); $n += $s.Length }} else {{ Start-Sleep -Milliseconds 50 }}
}}
$p.Close()
if ($n -eq 0) {{ Write-Output "KHONG_CO_DU_LIEU" }}
'''


# VID cac chip USB-UART hay gap tren board ESP32 (COM khac la Bluetooth, modem laptop...)
ESP_VIDS = {'10C4': 'CP210x', '1A86': 'CH340/CH9102', '0403': 'FTDI', '303A': 'Espressif'}


def com_ports():
    """[(COMx, ten, la_esp32)] cac cong COM dang cam tren Windows."""
    rc, out = ps_run('Get-PnpDevice -Class Ports -PresentOnly | ForEach-Object '
                     '{ $_.FriendlyName + "|" + $_.InstanceId }', timeout=30)
    ports = []
    for line in out.splitlines():
        if '|' not in line:
            continue
        name, inst = line.split('|', 1)
        m = re.search(r'\((COM\d+)\)', name)
        vid = re.search(r'VID_([0-9A-F]{4})', inst.upper())
        if m:
            ports.append((m.group(1), name.strip(), ESP_VIDS.get(vid.group(1)) if vid else None))
    return ports


def cmd_serial(a):
    ports = com_ports()
    if a.list:
        for com, name, chip in ports:
            print(f'{com}: {name}' + (f'  <- ESP32? ({chip})' if chip else ''))
        return
    port = a.port or DEFAULT_COM
    if not port:
        esp = [c for c, _, chip in ports if chip]
        if not esp:
            sys.exit('Khong thay cong COM nao cua ESP32 (CP210x/CH340/CH9102/FTDI). Cam cap USB '
                     'cua xe roi thu lai. Dang co: ' + ', '.join(f'{c} {n}' for c, n, _ in ports))
        port = esp[0]
        if len(esp) > 1:
            print(f'(co {len(esp)} cong ESP32: {esp} - doc {port}; chon cong khac: agvctl serial COMx)')
    rc, out = ps_run(PS_SERIAL.format(port=port, secs=a.t, reset='$true' if a.reset else '$false'),
                     timeout=a.t + 30)
    d = os.path.join(LOGS, 'serial')
    os.makedirs(d, exist_ok=True)
    path = os.path.join(d, time.strftime(f'{port}-%Y%m%d-%H%M%S.log'))
    open(path, 'w').write(out)
    print(out, end='')
    if 'KHONG_CO_DU_LIEU' in out:
        print(f'-> {port} mo duoc nhung {a.t} s khong co byte nao: ESP32 chua cap nguon / dang treo / '
              f'khong phai ESP32? Thu --reset de xem log khoi dong.')
    if 'LOI_MO_CONG' in out:
        print(f'\n-> Khong mo duoc {port}: Arduino IDE Serial Monitor dang giu cong? cap USB da cam?')
    print(f'\n(luu {path})')


# ---------------------------------------------------------------------- firmware
def _fw_source(xe):
    src = open(FW).read()
    new, n = re.subn(r'^#define XE \d', f'#define XE {xe}', src, count=1, flags=re.M)
    if n != 1:
        sys.exit('Khong tim thay dong "#define XE" trong firmware')
    return new


def _fw_car_text(xe):
    """File RIENG cua mot xe: file goc + dong canh bao o dau, XE dat san."""
    head = (f'// ===== FIRMWARE XE {xe} - FILE TU SINH, KHONG SUA O DAY =====\n'
            f'// Sinh tu firmware/esp32_agv_base/esp32_agv_base.ino boi: tools/agvctl fw split\n'
            f'// Sua code o file goc roi chay lai lenh tren (sinh ca xe1 lan xe2).\n')
    return head + _fw_source(xe)


def _write_car(xe):
    """firmware/xe<N>/xe<N>.ino trong repo + Xe_<N>/Xe_<N>.ino cua Arduino IDE."""
    text = _fw_car_text(xe)
    out = []
    for folder, name in ((os.path.join(WS, 'firmware', f'xe{xe}'), f'xe{xe}.ino'),
                         (os.path.join(IDE_ROOT, f'Xe_{xe}'), f'Xe_{xe}.ino')):
        ide = folder.startswith(IDE_ROOT)
        if ide and not os.path.isdir(IDE_ROOT):
            continue  # Linux native: Arduino IDE tren o Windows khong duoc mount.
        os.makedirs(folder, exist_ok=True)
        dst = os.path.join(folder, name)
        if ide and os.path.exists(dst):
            bak = os.path.join(LOGS, 'firmware', time.strftime(f'Xe_{xe}-%Y%m%d-%H%M%S.ino.bak'))
            os.makedirs(os.path.dirname(bak), exist_ok=True)
            shutil.copy(dst, bak)
        open(dst, 'w', newline='\r\n' if ide else '\n').write(text)
        shutil.copy(os.path.join(WS, 'firmware/esp32_agv_base/ydlidar_x2_intensity.h'),
                    os.path.join(folder, 'ydlidar_x2_intensity.h'))
        wc = os.path.join(folder, 'wifi_config.h')      # khong vao git (.gitignore)
        if not os.path.exists(wc):
            shutil.copy(_wifi_cfg(), wc)
        out.append(dst)
    return out


def _wifi_cfg():
    for p in (os.path.join(WS, 'firmware/esp32_agv_base/wifi_config.h'),
              os.path.join(IDE_SKETCH, 'wifi_config.h')):
        if os.path.exists(p):
            return p
    sys.exit('Khong co wifi_config.h (firmware/esp32_agv_base/ hoac thu muc Arduino IDE)')


def cmd_fw(a):
    xe = a.xe
    if a.action == 'split' or (a.action == 'copy' and xe is None):
        for x in (1, 2):
            for dst in _write_car(x):
                print(f'XE {x}: {dst}')
        if os.path.isdir(IDE_ROOT):
            print(r'Nap: Arduino IDE mo Xe_1\Xe_1.ino cho xe 1, Xe_2\Xe_2.ino cho xe 2 (giu BOOT).')
        else:
            print('Da sinh firmware trong repo; dung arduino-cli de bien dich va nap.')
        return
    if a.action == 'build' and xe is None:
        sys.exit('fw build can so xe: tools/agvctl fw build 1')
    if a.action == 'copy':
        for dst in _write_car(xe):
            print(f'XE {xe}: {dst}')
        return
    if a.action == 'build':
        sk = os.path.join(WIN_TMP, f'xe{xe}', 'esp32_agv_base')
        os.makedirs(sk, exist_ok=True)
        open(os.path.join(sk, 'esp32_agv_base.ino'), 'w').write(_fw_source(xe))
        shutil.copy(_wifi_cfg(), os.path.join(sk, 'wifi_config.h'))
        t0 = time.time()
        p = subprocess.run([ARDUINO_CLI, 'compile', '--config-file', ARDUINO_CFG, '--fqbn', FQBN,
                            '--build-path', WIN_TMP_W + rf'\build_xe{xe}', '--warnings', 'default',
                            WIN_TMP_W + rf'\xe{xe}\esp32_agv_base'],
                           capture_output=True, text=True, cwd='/mnt/c', timeout=1800)
        out = (p.stdout + p.stderr).replace('\r', '')
        log = os.path.join(LOGS, 'firmware')
        os.makedirs(log, exist_ok=True)
        path = os.path.join(log, time.strftime(f'build-xe{xe}-%Y%m%d-%H%M%S.log'))
        open(path, 'w').write(out)
        # -Wvolatile ('++' bien volatile): co tu truoc, vo hai - bo khoi tom tat
        errs = [l for l in out.splitlines() if re.search(r'\b(error|warning)\b', l, re.I)
                and 'esp32_agv_base' in l and 'Wvolatile' not in l]
        size = [l for l in out.splitlines() if 'Sketch uses' in l or 'Global variables' in l]
        print('\n'.join(errs[:40]) or '(khong co loi/canh bao trong sketch)')
        print('\n'.join(size))
        print(f'{"BIEN DICH OK" if p.returncode == 0 else "BIEN DICH LOI"} (XE {xe}, '
              f'{time.time() - t0:.0f} s). Log day du: {path}')
        if p.returncode:
            print(out[-3000:])
        sys.exit(p.returncode)
    if a.action == 'copy':
        dst = os.path.join(IDE_SKETCH, 'Xe_lidar.ino')
        if os.path.exists(dst):
            bak = os.path.join(LOGS, 'firmware', time.strftime('Xe_lidar-%Y%m%d-%H%M%S.ino.bak'))
            os.makedirs(os.path.dirname(bak), exist_ok=True)
            shutil.copy(dst, bak)
        open(dst, 'w', newline='\r\n').write(_fw_source(xe))
        print(f'Da chep firmware XE {xe} -> {dst} (ban cu luu o ~/agv_logs/firmware/). '
              f'Mo Arduino IDE, giu BOOT va nap.')


# ---------------------------------------------------------------------- main
def main():
    ap = argparse.ArgumentParser(prog='agvctl', description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest='cmd', required=True)
    sub.add_parser('doctor')
    p = sub.add_parser('up')
    p.add_argument('--cars', default='agv1,agv2')
    p.add_argument('--emulate', action='store_true', help='ESP32 gia (can ROS_DOMAIN_ID khac 0)')
    p.add_argument('--no-tm', action='store_true', help='khong bat traffic_manager')
    sub.add_parser('down')
    p = sub.add_parser('status')
    p.add_argument('--json', action='store_true')
    for name in ('errors', 'events'):
        p = sub.add_parser(name)
        p.add_argument('-n', type=int, default=30)
    p = sub.add_parser('logs')
    p.add_argument('name', nargs='?')
    p.add_argument('-n', type=int, default=50)
    p = sub.add_parser('goal')
    p.add_argument('text')
    p.add_argument('--go', action='store_true', help='cho phep xe THAT chay (domain 0)')
    sub.add_parser('stop')
    p = sub.add_parser('localize')
    p.add_argument('car')
    p = sub.add_parser('serial')
    p.add_argument('port', nargs='?')
    p.add_argument('-t', type=int, default=10, help='doc bao nhieu giay')
    p.add_argument('--reset', action='store_true', help='nhan EN qua RTS de xem log khoi dong')
    p.add_argument('--list', action='store_true')
    p = sub.add_parser('fw')
    p.add_argument('action', choices=['build', 'copy', 'split'])
    p.add_argument('xe', type=int, choices=[1, 2], nargs='?')
    p = sub.add_parser('_bringup')
    p.add_argument('run')
    a = ap.parse_args()
    if a.cmd == '_bringup':
        return _bringup(a.run)
    return {'doctor': cmd_doctor, 'up': cmd_up, 'down': cmd_down, 'status': cmd_status,
            'errors': cmd_errors, 'events': cmd_events, 'logs': cmd_logs, 'goal': cmd_goal,
            'stop': cmd_stop, 'localize': cmd_localize, 'serial': cmd_serial,
            'fw': cmd_fw}[a.cmd](a)


if __name__ == '__main__':
    sys.exit(main() or 0)
