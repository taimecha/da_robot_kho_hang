# ---------------------------------------------------------------------- tien ich
def sh(cmd, timeout=None, check=False):
    """Chay lenh bash (co moi truong ROS), tra (ma, stdout+stderr)."""
    p = subprocess.run(['bash', '-c', ROS_SETUP + cmd], capture_output=True, text=True,
                       timeout=timeout)
    if check and p.returncode:
        sys.exit(p.stdout + p.stderr)
    return p.returncode, (p.stdout + p.stderr)


def spawn(cmd, log, env=None):
    """Bat tien trinh nen trong nhom rieng (kill ca nhom duoc). Tra pid."""
    e = dict(os.environ, **(env or {}))
    with open(log, 'ab') as f:
        p = subprocess.Popen(['bash', '-c', ROS_SETUP + 'exec ' + cmd], stdout=f,
                             stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                             start_new_session=True, env=e)
    return p.pid


def run_dir():
    if not os.path.exists(LATEST):
        sys.exit('Chua co lan chay nao (agvctl up).')
    return os.path.realpath(LATEST)


def add_pid(run, name, pid):
    with open(os.path.join(run, 'pids.json'), 'a') as f:
        f.write(json.dumps({'name': name, 'pid': pid}) + '\n')


def read_pids(run):
    path = os.path.join(run, 'pids.json')
    if not os.path.exists(path):
        return []
    return [json.loads(line) for line in open(path) if line.strip()]


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def kill_group(pid, sig):
    try:
        os.killpg(pid, sig)
    except OSError:
        pass


def tail(path, n):
    if not os.path.exists(path):
        return f'(chua co {path})'
    with open(path, errors='replace') as f:
        return ''.join(f.readlines()[-n:])


def domain():
    return int(os.environ.get('ROS_DOMAIN_ID', '0') or 0)


def ps_run(script, timeout=60):
    """Chay PowerShell cua Windows, tra (ma, output)."""
    p = subprocess.run(['powershell.exe', '-NoProfile', '-NonInteractive', '-Command', script],
                       capture_output=True, text=True, timeout=timeout, cwd='/mnt/c')
    return p.returncode, (p.stdout + p.stderr).replace('\r', '')


