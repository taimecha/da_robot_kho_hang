Panels:
- Class: rviz_common/Displays
  Name: Displays
  Help Height: 0
  Tree Height: 400
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Map
    Name: Ban do
    Enabled: true
    Alpha: 0.7
    Color Scheme: map
    Draw Behind: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map
    Update Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map_updates
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Name: Sa ban + ba xe
    Enabled: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /fleet/markers
    Namespaces: {}
    Value: true
  - Class: rviz_common/Group
    Enabled: true
    Name: Xe 1 (agv1)
    Displays:
    - Class: rviz_default_plugins/RobotModel
      Name: Mo hinh xe
      Enabled: true
      Alpha: 1
      Description Source: File
      Description File: /home/tai/Robot_kho_clone/data/warehouse_demo_20261027_105246/agv1.urdf
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /agv1/robot_description
      TF Prefix: agv1
      Visual Enabled: true
      Collision Enabled: false
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /fleet_viz/agv1/scan
      Style: Points
      Size (Pixels): 5
      Size (m): 0.05
      Color Transformer: FlatColor
      Color: 38; 115; 255
      Alpha: 1
      Decay Time: 0
      Position Transformer: XYZ
      Use Fixed Frame: true
      Selectable: true
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: false
      Alpha: 0.7
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fleet_viz/agv1/local_costmap/costmap
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fleet_viz/agv1/local_costmap/costmap_updates
      Use Timestamp: false
      Value: false
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: false
      Alpha: 0.3
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fleet_viz/agv1/global_costmap/costmap
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fleet_viz/agv1/global_costmap/costmap_updates
      Use Timestamp: false
      Value: false
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Color: 38; 115; 255
      Alpha: 1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fleet_viz/agv1/local_costmap/published_footprint
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Doan dang chay
      Enabled: true
      Color: 38; 115; 255
      Alpha: 1
      Buffer Length: 1
      Line Style: Lines
      Line Width: 0.03
      Pose Style: None
      Offset:
        X: 0
        Y: 0
        Z: 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fleet_viz/agv1/received_global_plan
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Enabled: true
      Color: 38; 115; 255
      Alpha: 1
      Buffer Length: 1
      Line Style: Lines
      Line Width: 0.03
      Pose Style: None
      Offset:
        X: 0
        Y: 0
        Z: 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fleet_viz/agv1/local_plan
      Value: true
