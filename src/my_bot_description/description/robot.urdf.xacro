<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_bot">

    <!-- sim=true  : nap plugin + sensor cua Gazebo (chay mo phong)
         sim=false : chi con phan co khi thuan tuy, dung cho xe that vi luc do
                     /scan va /odom do ESP32 phat, khong phai Gazebo. -->
    <xacro:arg name="sim" default="true" />
    <!-- Fleet real: AGV1 blue, AGV2 orange. Defaults retain the simulation look. -->
    <xacro:arg name="body_color" default="orange" />
    <xacro:arg name="wheel_color" default="blue" />

    <!-- ====================================================================
         KICH THUOC XE
         ====================================================================
         Nhom 1 - DO BANG THUOC tren xe that. Sua o day la sua moi noi.
         Ba file khac phai khop voi cac so nay, xem cuoi khoi nay. -->
    <xacro:property name="wheel_separation" value="0.200"/>  <!-- tam - tam hai banh sau -->
    <xacro:property name="wheel_radius"     value="0.03225"/><!-- duong kinh 64.5 mm -->
    <xacro:property name="wheel_x"          value="-0.014"/> <!-- truc banh sau lui 14 mm sau tam -->
    <xacro:property name="caster_x"         value="0.035"/>  <!-- banh da huong tien 35 mm truoc tam -->
    <xacro:property name="body_radius"      value="0.0907"/> <!-- duong kinh than 181.40 mm -->
    <xacro:property name="wheel_width"      value="0.026"/>  <!-- be rong lop 26 mm -->

    <!-- Nhom 2 - CHUA DO, dang la so dat tam cho hinh hoc dung duoc.
         Sai cac so nay khong lam odometry sai, chi lam hinh trong RViz va
         vat ly trong Gazebo khong giong that. Do roi thi sua vao day. -->
    <xacro:property name="body_height"      value="0.040"/>  <!-- be day than xe -->
    <xacro:property name="caster_radius"    value="0.015"/>  <!-- ban kinh bi da huong -->
    <xacro:property name="lidar_z"          value="0.075"/>  <!-- tam LiDAR cao hon mat san -->
    <xacro:property name="imu_z"            value="0.055"/>  <!-- tam BNO055 cao hon mat san -->
    <xacro:property name="body_mass"        value="1.2"/>
    <xacro:property name="wheel_mass"       value="0.05"/>
    <xacro:property name="caster_mass"      value="0.02"/>

    <!-- BA CHO KHAC PHAI KHOP VOI NHOM 1:
           gazebo_control.xacro       <wheel_separation> va <wheel_radius>
           firmware/.../esp32_agv_base.ino   WHEEL_SEPARATION_M, WHEEL_RADIUS_M
           config/navigation.yaml     robot_radius (= diem xa tam nhat, xem duoi)

         Diem xa tam nhat KHONG phai mep than xe (0.0907) ma la goc ngoai cua
         banh sau, vi hai banh cach nhau 200 mm trong khi than chi rong 181.40:
           x = wheel_x - wheel_radius = -0.014 - 0.03225 = -0.046
           y = wheel_separation/2 + wheel_width/2 = 0.100 + 0.013 = 0.113
           khoang cach = sqrt(0.046^2 + 0.113^2) = 0.122 m
         Ca ba so trong phep tinh nay deu do that -> navigation.yaml dat
         robot_radius 0.13 (co bien 8 mm). -->

    <material name="white"><color rgba="1 1 1 1" /></material>
    <material name="blue"><color rgba="0.15 0.45 0.95 1"/></material>
    <material name="black"><color rgba="0 0 0 1"/></material>
    <material name="orange"><color rgba="0.95 0.5 0.1 1"/></material>
    <material name="red"><color rgba="1 0 0 1"/></material>

    <!-- base_footprint nam tren MAT SAN, ngay duoi TAM TRUC BANH (tam xoay cua xe
         vi sai). base_link = tam than, truoc truc 14 mm (-wheel_x); moi toa do
         z duoi day deu la chieu cao so voi san.
         Truoc 2026-10-10 base_footprint o tam THAN: xoay tai cho 180 do lam "vi tri
         xe" (odom/AMCL/sa ban) troi 2.8 cm (90 do: 2 cm) ma odometry vi sai khong
         biet -> xe 2 xe that toi dich lech 3-4.4 cm sau cu xoay cuoi. Gio xoay tai
         cho khong doi vi tri; tam than luon nam truoc nut 1.4 cm theo mui xe. -->
    <link name="base_footprint"/>
    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="${-wheel_x} 0 0" rpy="0 0 0"/>
    </joint>

    <link name="base_link"></link>

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="0 0 0"/>
    </joint>
    <link name="chassis">
        <!-- Than dat o ngang tam truc banh -> gam cao 12 mm -->
        <visual>
            <origin xyz="0 0 ${wheel_radius}"/>
            <geometry><cylinder radius="${body_radius}" length="${body_height}"/></geometry>
            <material name="$(arg body_color)"/>
        </visual>
        <collision>
            <origin xyz="0 0 ${wheel_radius}"/>
            <geometry><cylinder radius="${body_radius}" length="${body_height}"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
            <mass value="${body_mass}"/>
            <inertia
                ixx="${body_mass*(3*body_radius*body_radius + body_height*body_height)/12}"
                ixy="0.0" ixz="0.0"
                iyy="${body_mass*(3*body_radius*body_radius + body_height*body_height)/12}"
                iyz="0.0"
                izz="${body_mass*body_radius*body_radius/2}"/>
        </inertial>
    </link>

    <!-- Hai banh sau. Truc nam o z = wheel_radius thi lop vua cham san. -->
    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="${wheel_x} ${wheel_separation/2} ${wheel_radius}" rpy="-1.5707 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>
    <link name="left_wheel">
        <visual>
            <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
            <material name="$(arg wheel_color)"/>
        </visual>
        <collision>
            <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${wheel_mass}"/>
            <inertia
                ixx="${wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12}"
                ixy="0.0" ixz="0.0"
                iyy="${wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12}"
                iyz="0.0"
                izz="${wheel_mass*wheel_radius*wheel_radius/2}"/>
        </inertial>
    </link>

    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="${wheel_x} ${-wheel_separation/2} ${wheel_radius}" rpy="1.5707 0 0"/>
        <axis xyz="0 0 -1"/>
    </joint>
    <link name="right_wheel">
        <visual>
            <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
            <material name="$(arg wheel_color)"/>
        </visual>
        <collision>
            <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${wheel_mass}"/>
            <inertia
                ixx="${wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12}"
                ixy="0.0" ixz="0.0"
                iyy="${wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12}"
                iyz="0.0"
                izz="${wheel_mass*wheel_radius*wheel_radius/2}"/>
        </inertial>
    </link>

    <!-- Banh da huong phia truoc. Tam o z = caster_radius thi bi vua cham san. -->
    <joint name="front_caster_joint" type="fixed">
        <parent link="chassis"/>
        <child link="front_caster"/>
        <origin xyz="${caster_x} 0 ${caster_radius}"/>
    </joint>
    <link name="front_caster">
        <visual>
            <geometry><sphere radius="${caster_radius}"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry><sphere radius="${caster_radius}"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${caster_mass}"/>
            <inertia
                ixx="${2*caster_mass*caster_radius*caster_radius/5}" ixy="0.0" ixz="0.0"
                iyy="${2*caster_mass*caster_radius*caster_radius/5}" iyz="0.0"
                izz="${2*caster_mass*caster_radius*caster_radius/5}"/>
        </inertial>
    </link>

    <!-- Bi da huong khong duoc co ma sat, neu khong xe se khong quay not -->
    <gazebo reference="front_caster">
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
        <material>Gazebo/Black</material>
    </gazebo>

    <!-- rpy PHAI giu nguyen 0 0 0.
         Goc lap lech cua LiDAR da duoc bu trong firmware bang
         LIDAR_ANGLE_OFFSET_DEG (do duoc 180 do). Them yaw vao day nua la bu
         thua gap doi va anh quet se lech nguoc lai dung chung do. -->
    <joint name="lidar_joint" type="fixed">
        <parent link="chassis"/>
        <child link="lidar_link"/>
        <origin xyz="0 0 ${lidar_z}" rpy="0 0 0"/>
    </joint>
    <link name="lidar_link">
        <visual>
            <geometry><cylinder radius="0.030" length="0.030"/></geometry>
            <material name="black"/>
        </visual>
    </link>
    <xacro:if value="$(arg sim)">
    <gazebo reference="lidar_link">
        <sensor name="lidar" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.15</min>
                    <max>8.0</max>
                    <resolution>0.01</resolution>
                </range>
            </ray>
            <topic>scan</topic>
            <gz_frame_id>lidar_link</gz_frame_id>
        </sensor>
    </gazebo>
    </xacro:if>

    <!-- IMU BNO055. Firmware phat /imu/data voi frame_id = imu_link,
         neu thieu link nay TF se bao loi "frame does not exist". -->
    <joint name="imu_joint" type="fixed">
        <parent link="chassis"/>
        <child link="imu_link"/>
        <origin xyz="0 0 ${imu_z}" rpy="0 0 0"/>
    </joint>
    <link name="imu_link"/>

</robot>
